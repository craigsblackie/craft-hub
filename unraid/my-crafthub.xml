<?xml version="1.0"?>
<Container version="2">
  <Name>crafthub</Name>
  <Repository>ghcr.io/craigsblackie/craft-hub:latest</Repository>
  <Registry>https://github.com/craigsblackie/craft-hub/pkgs/container/craft-hub</Registry>
  <Network>proxynet</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/craigsblackie/craft-hub/issues</Support>
  <Project>https://github.com/craigsblackie/craft-hub</Project>
  <Overview>CraftHub: a modern web console to install, update, roll back, delete and host the storytold *craft clean-room WebAssembly apps (PhotoCraft, WordCraft, ...). Served behind SWAG.</Overview>
  <Category>Tools:</Category>
  <WebUI>https://craft.craigsblackie.com/</WebUI>
  <ExtraParams>--user 99:100 --cap-drop=ALL --security-opt=no-new-privileges:true --read-only --tmpfs /tmp</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <Icon>https://raw.githubusercontent.com/craigsblackie/craft-hub/main/icon.png</Icon>
  <Requires/>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/crafthub/data" Mode="rw" Description="Installed apps and state" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/crafthub/data</Config>
  <Config Name="Packages" Target="/packages" Default="/mnt/user/appdata/crafthub/packages" Mode="rw" Description="Downloaded release zips (kept for reinstall/rollback)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/crafthub/packages</Config>
  <Config Name="KEEP_PACKAGES" Target="KEEP_PACKAGES" Default="3" Mode="" Description="Zips to keep per app" Type="Variable" Display="advanced" Required="false" Mask="false">3</Config>
  <Config Name="GH_OWNER" Target="GH_OWNER" Default="storytold" Mode="" Description="GitHub user/org to pull apps from" Type="Variable" Display="always" Required="true" Mask="false">storytold</Config>
  <Config Name="GITHUB_TOKEN" Target="GITHUB_TOKEN" Default="" Mode="" Description="Optional token; raises the GitHub API rate limit (only ever sent to api.github.com)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="CHECK_INTERVAL_HOURS" Target="CHECK_INTERVAL_HOURS" Default="6" Mode="" Description="How often to check for new versions" Type="Variable" Display="always" Required="false" Mask="false">6</Config>
  <Config Name="AUTO_UPDATE_ALL" Target="AUTO_UPDATE_ALL" Default="false" Mode="" Description="Automatically upgrade every installed app (true/false)" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="ALLOWED_HOSTS" Target="ALLOWED_HOSTS" Default="" Mode="" Description="Comma-separated Host names the UI answers to (blocks DNS-rebinding). Empty = any. e.g. craft.example.com,192.168.1.10" Type="Variable" Display="always" Required="false" Mask="false">craft.craigsblackie.com</Config>
  <Config Name="MIN_RELEASE_AGE_HOURS" Target="MIN_RELEASE_AGE_HOURS" Default="24" Mode="" Description="Warn before installing releases younger than this, and hold them back from auto-update (0 disables)" Type="Variable" Display="always" Required="false" Mask="false">24</Config>
  <Config Name="NOTIFY_URL" Target="NOTIFY_URL" Default="" Mode="" Description="Optional ntfy-style URL (text POST with Title header) for update/failure notifications" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="MAX_UNPACKED_MB" Target="MAX_UNPACKED_MB" Default="500" Mode="" Description="Reject packages that unpack larger than this" Type="Variable" Display="advanced" Required="false" Mask="false">500</Config>
  <Config Name="REPO_PATTERN" Target="REPO_PATTERN" Default="^[a-z]+craft$" Mode="" Description="Regex of repo names to list" Type="Variable" Display="advanced" Required="false" Mask="false">^[a-z]+craft$</Config>
  <Config Name="EXCLUDE_REPOS" Target="EXCLUDE_REPOS" Default="artcraft" Mode="" Description="Comma-separated repos to hide" Type="Variable" Display="advanced" Required="false" Mask="false">artcraft</Config>
  <Config Name="EXTRA_REPOS" Target="EXTRA_REPOS" Default="" Mode="" Description="Comma-separated extra repos to include regardless of pattern" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
